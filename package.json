{
  "name": "@c9up/inker",
  "version": "0.1.17",
  "description": "Inker \u2014 server-side templating for the Ream framework. Hand-rolled lexer/parser/renderer with HTML-escape-by-default interpolation and .inker file convention.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/InkerProvider.ts",
      "import": "./src/InkerProvider.ts"
    },
    "./services/main": {
      "types": "./src/services/main.ts",
      "import": "./src/services/main.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:napi": "cargo build --release -p inker-engine-napi && pnpm build:napi-types && node scripts/copy-napi.mjs",
    "build:napi-types": "node scripts/build-napi-types.mjs",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@c9up/ream": "^0.2.0",
    "@c9up/rosetta": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@c9up/ream": {
      "optional": true
    },
    "@c9up/rosetta": {
      "optional": true
    }
  },
  "devDependencies": {
    "@c9up/rosetta": "^0.3.0",
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "@c9up/ream": "^0.2.0"
  },
  "pnpm": {
    "//": "Pin the coverage toolchain to the version used in dev. Without a committed lockfile the standalone CI resolves fresh (@vitest/coverage-v8 4.1.9), whose v8 branch-counting drops inker under its 78% floor and reds the coverage gate. Overrides only apply when this package is the install root (CI), so the monorepo workspace is unaffected.",
    "overrides": {
      "@vitest/coverage-v8": "4.1.6",
      "vitest": "4.1.6"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "index.*.node"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/InkerProvider.d.ts",
        "import": "./dist/InkerProvider.js"
      },
      "./services/main": {
        "types": "./dist/services/main.d.ts",
        "import": "./dist/services/main.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/inker.git"
  }
}
